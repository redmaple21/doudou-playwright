# 目标网站配置
TARGET_URL=https://example.com
LOGIN_URL=https://example.com/login

# 用户凭证
LOGIN_EMAIL=your_username
LOGIN_PASSWORD=your_password

# Playwright 配置
HEADLESS=false
TIMEOUT=30000

# 签到配置
SIGNIN_URL=https://example.com/signin

# 微信推送配置（爱语飞飞）
# 申请地址：https://iyuu.cn/
# 如果不需要推送到微信，可以留空或注释掉这一行
IYUU_TOKEN=

# 企业微信推送配置（群机器人 Webhook）
# 在企业微信群聊中「添加群机器人」后复制完整 Webhook 地址，格式如：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 不配置则不发企业微信
WECOM_WEBHOOK_URL=
